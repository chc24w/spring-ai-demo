<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chc.ai</groupId>
        <artifactId>spring-ai-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai01-model</artifactId>
    <name>ai01-model</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chc.ai</groupId>
            <artifactId>common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!--spring ai 接入 deepseek,要接入什么模型直接引入对应的starter即可,步骤:
        1.引入依赖
        2.application.yml配置
        3.调用参见 DeepSeekController
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <!--spring ai 接入 ollama,步骤:
       1.引入依赖
       2.application.yml配置
       3.调用参见 OllamaController-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!--如何访问没有内置starter的厂商模型，1、基于open API风格，2、基于Anthropic API风格-->
        <!--spring ai 接入openai api风格的套用模型(如chatGPT或
            其他厂商提供的兼容open api风格的模型,如deepseek),步骤:
            1.引入依赖
            2.application.yml配置
            3.调用参见 OpenaiController
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!--spring ai 接入anthropic api风格的模型(如claude或
              其他厂商提供的兼容anthropic api风格的模型,如deepseek),步骤:
              1.引入依赖
              2.application.yml配置
              3.调用参见 AnthropicController
          -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
    </dependencies>
</project>
